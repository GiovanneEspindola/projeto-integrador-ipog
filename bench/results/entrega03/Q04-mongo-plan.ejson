              },
              0
            ]
          },
          "valor": {
            "$ifNull": [
              {
                "$first": "$vendas.valor"
              },
              {
                "$numberDecimal": "0"
              }
            ]
          }
        }
      },
      {
        "$setWindowFields": {
          "output": {
            "total": {
              "$sum": "$valor",
              "window": {
                "documents": [
                  "unbounded",
                  "unbounded"
                ]
              }
            }
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "employee_id": "$_id",
          "funcionario": {
            "$concat": [
              "$first_name",
              " ",
              "$last_name"
            ]
          },
          "pedidos": 1,
          "valor": 1,
          "ticket": {
            "$cond": [
              {
                "$eq": [
                  "$pedidos",
                  0
                ]
              },
              null,
              {
                "$divide": [
                  "$valor",
