  "command": {
    "aggregate": "employees",
    "pipeline": [
      {
        "$lookup": {
          "from": "orders",
          "localField": "_id",
          "foreignField": "employee_id",
          "pipeline": [
            {
              "$match": {
                "order_date": {
                  "$gte": {
                    "$date": "1996-07-01T00:00:00Z"
                  },
                  "$lt": {
                    "$date": "1998-06-01T00:00:00Z"
                  }
                }
              }
            },
            {
              "$group": {
                "_id": null,
                "pedidos": {
                  "$sum": 1
                },
                "valor": {
                  "$sum": {
                    "$sum": {
                      "$map": {
                        "input": "$items",
                        "as": "i",
                        "in": {
                          "$multiply": [
                            "$$i.unit_price",
                            "$$i.quantity",
                            {
                              "$subtract": [
                                {
                                  "$numberDecimal": "1"
                                },
                                "$$i.discount"
                              ]
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          ],
          "as": "vendas"
        }
      },
      {
        "$set": {
          "pedidos": {
