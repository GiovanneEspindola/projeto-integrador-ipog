        <mxCell id="titulo" value="Modelo Entidade-Relacionamento CONCEITUAL — Northwind Traders" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="900" height="38" as="geometry" />
        </mxCell>
        <mxCell id="subtitulo" value="Distribuidora de alimentos · entidades, relacionamentos e cardinalidades." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="64" width="900" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legenda" value="&lt;b&gt;Notação pé-de-galinha&lt;/b&gt;&lt;br&gt;&lt;br&gt;||—  exatamente um (1,1)&lt;br&gt;|○—  zero ou um (0,1)&lt;br&gt;—‹   um ou muitos (1,N)&lt;br&gt;○‹   zero ou muitos (0,N)&lt;br&gt;&lt;br&gt;&lt;b&gt;Cores&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#82b366&#x27;&gt;■&lt;/font&gt; o que a empresa vende&lt;br&gt;&lt;font color=&#x27;#6c8ebf&#x27;&gt;■&lt;/font&gt; a venda em si&lt;br&gt;&lt;font color=&#x27;#d79b00&#x27;&gt;■&lt;/font&gt; quem vende e quem entrega&lt;br&gt;&lt;font color=&#x27;#9673a6&#x27;&gt;■&lt;/font&gt; entidade associativa" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="250" height="250" as="geometry" />
        </mxCell>
        <mxCell id="nota1" value="&lt;b&gt;Por que ITEM DO PEDIDO existe&lt;/b&gt;&lt;br&gt;&lt;br&gt;PEDIDO é o cabeçalho da venda; ITEM DO PEDIDO é o corpo, uma linha por produto. É o cupom fiscal.&lt;br&gt;&lt;br&gt;O preço aparece nos dois de propósito: em PRODUTO é o preço de hoje, em ITEM DO PEDIDO é o preço congelado no dia da venda." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="700" width="420" height="250" as="geometry" />
        </mxCell>
        <mxCell id="nota2" value="&lt;b&gt;ATUAÇÃO: a estrutura diz N:N, os dados dizem 1:N&lt;/b&gt;&lt;br&gt;&lt;br&gt;Medido na base: &lt;b&gt;49 vínculos para 49 territórios distintos&lt;/b&gt; — nenhum território tem mais de um responsável, e &lt;b&gt;4 dos 53&lt;/b&gt; não têm nenhum.&lt;br&gt;&lt;br&gt;Mantido N:N: suportar o caso futuro custa uma tabela, não suportar custa uma migração." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="700" width="430" height="250" as="geometry" />
        </mxCell>
        <mxCell id="nota3" value="&lt;b&gt;O que ficou de fora, e por quê&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CUSTOMER_DEMOGRAPHICS&lt;/b&gt; e &lt;b&gt;CUSTOMER_CUSTOMER_DEMO&lt;/b&gt;: 0 linhas as duas — intenção que nunca virou dado.&lt;br&gt;&lt;br&gt;&lt;b&gt;US_STATES&lt;/b&gt;: 51 linhas, mas nenhuma chave estrangeira aponta para ela. É lista de referência, não entidade do negócio." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1350" y="700" width="400" height="250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
