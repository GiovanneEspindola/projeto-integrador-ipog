<mxfile host="app.diagrams.net">
  <diagram name="Arquitetura híbrida" id="arq1">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="Arquitetura híbrida — PostgreSQL como fonte, MongoDB como cópia documental" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1100" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitulo" value="Fluxo de mão única. O relacional registra; o documental serve. As mesmas 16 perguntas rodam nos dois." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="app" value="&lt;b&gt;Aplicação / carga inicial&lt;/b&gt;&lt;br&gt;&lt;br&gt;É aqui que a venda acontece.&lt;br&gt;Escreve só de um lado." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL — schema nw&lt;/b&gt;&lt;br&gt;&lt;i&gt;fonte da verdade&lt;/i&gt;&lt;br&gt;&lt;br&gt;11 tabelas · 11 chaves estrangeiras&lt;br&gt;17 CHECK · 4 UNIQUE&lt;br&gt;4 índices · 4 views&lt;br&gt;&lt;br&gt;O banco &lt;b&gt;recusa&lt;/b&gt; o dado inválido:&lt;br&gt;a garantia é declarativa, não da aplicação." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="130" width="300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="mongo" value="&lt;b&gt;MongoDB — cópia documental&lt;/b&gt;&lt;br&gt;&lt;i&gt;não recebe escrita de aplicação&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;orders&lt;/b&gt; — o agregado central:&lt;br&gt;itens embutidos + snapshot do&lt;br&gt;cliente e do vendedor&lt;br&gt;&lt;b&gt;products&lt;/b&gt; — extended reference&lt;br&gt;&lt;b&gt;customers&lt;/b&gt; — endereço embutido&lt;br&gt;&lt;b&gt;employees&lt;/b&gt; — hierarquia por referência" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="800" y="130" width="300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="etl" value="&lt;b&gt;etl/migrate.py&lt;/b&gt;&lt;br&gt;lote · idempotente&lt;br&gt;mão única" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;spacingLeft=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="205" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="perguntas" value="&lt;b&gt;As mesmas 16 perguntas de negócio&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cada uma respondida duas vezes. Se os dois lados derem números diferentes, o trabalho para até a causa aparecer — divergência é achado, não bug." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="430" y="470" width="620" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sql" value="sql/queries/&lt;b&gt;QNN.sql&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;spacingLeft=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="390" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="js" value="mongo/pipelines/&lt;b&gt;PNN.js&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;arcSize=8;fillColor=#ffffff;strokeColor=#82b366;align=center;spacingLeft=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="850" y="390" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bench" value="&lt;b&gt;Benchmark&lt;/b&gt; — descarta a 1ª execução, roda N ≥ 10, reporta a &lt;b&gt;mediana&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=center;spacingLeft=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="600" width="620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeWidth=2;strokeColor=#4d4d4d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="app" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeWidth=2;strokeColor=#4d4d4d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pg" target="etl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeWidth=2;strokeColor=#4d4d4d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="etl" target="mongo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeWidth=2;strokeColor=#4d4d4d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sql" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeWidth=2;strokeColor=#4d4d4d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="js" target="mongo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeWidth=2;strokeColor=#4d4d4d;labelBackgroundColor=#ffffff;exitX=0.1;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="perguntas" target="sql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeWidth=2;strokeColor=#4d4d4d;labelBackgroundColor=#ffffff;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="perguntas" target="js">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeWidth=2;strokeColor=#4d4d4d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="perguntas" target="bench">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;Por que mão única&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sincronizar nos dois sentidos exigiria decidir quem ganha quando os dois lados mudam o mesmo dado, e qualquer resposta a isso é arbitrária. &lt;b&gt;Um dado com dois donos é um dado sem dono.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;arcSize=10;dashed=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;Por que lote, e não tempo real&lt;/b&gt;&lt;br&gt;&lt;br&gt;Captura de mudança em tempo real (Debezium + Kafka) funciona, mas é a escolha certa para quem tem requisito de latência. Aqui nenhuma das 16 perguntas melhora com dado de um segundo atrás — e seriam dois serviços a mais para o avaliador subir." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;arcSize=10;dashed=0;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;O trade-off, em uma frase&lt;/b&gt;&lt;br&gt;&lt;br&gt;A junção que o PostgreSQL faz em tempo de &lt;b&gt;consulta&lt;/b&gt;, o MongoDB faz em tempo de &lt;b&gt;escrita&lt;/b&gt;, uma vez só, no ETL. O documental paga antecipado — e cobra caro quando você quer cruzar de um jeito que ele não previu." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;arcSize=10;dashed=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="660" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;O que o experimento não prova&lt;/b&gt;&lt;br&gt;&lt;br&gt;830 pedidos rodam em milissegundos nos dois bancos: isto &lt;b&gt;não mede escalabilidade&lt;/b&gt;. E o MongoDB roda em nó único, sem sharding — a maior vantagem estrutural dele não é exercitada. Comparar assim favorece o relacional, e é honesto dizer." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;arcSize=10;dashed=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="750" y="660" width="300" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
