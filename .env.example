# ---------------------------------------------------------------------------
# .env.example — modelo de configuração local
#
# COMO USAR: copie para .env e ajuste se precisar.
#     cp .env.example .env
#
# Você só precisa de um .env se alguma das portas abaixo já estiver ocupada
# na sua máquina. Sem .env, o docker-compose.yml usa os valores padrão.
# O arquivo .env NÃO é versionado (está no .gitignore); este modelo é.
# ---------------------------------------------------------------------------

# Porta em que o PostgreSQL do container fica acessível na sua máquina.
#
# ATENÇÃO — o conflito clássico neste projeto: se você tem um PostgreSQL
# instalado direto no sistema (não em container), ele provavelmente já está
# usando a 5432, e o container vai falhar com "port is already allocated".
#
# Duas saídas:
#   (a) desligar o PostgreSQL do sistema  ->  sudo systemctl disable --now postgresql
#   (b) mudar a porta do container aqui   ->  POSTGRES_PORT=5433
#
# A opção (a) é a adotada no desenvolvimento deste projeto, para que a string
# de conexão da documentação seja sempre a mesma. Se você escolher a (b),
# lembre de trocar 5432 por 5433 em todas as strings de conexão.
POSTGRES_PORT=5432

# Porta em que o MongoDB do container fica acessível na sua máquina.
# Raramente precisa mudar — o MongoDB não costuma vir instalado por padrão.
MONGO_PORT=27017
